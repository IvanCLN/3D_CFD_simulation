FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (15 0 0);

boundaryField
{
    frontAndBack
    {
        type            slip;
    }
    inlet
    {
        type            fixedValue;
        value           uniform (15 0 0);
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (15 0 0);
    }
    lowerWall
    {
        type            movingWallVelocity;
        value           uniform (15 0 0);
    }
    upperWall
    {
        type            slip;
    }
    T1rs
    {
        type            noSlip;
    }
}


