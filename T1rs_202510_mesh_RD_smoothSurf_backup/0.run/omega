FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 3.67;

boundaryField
{
    frontAndBack
    {
        type            slip;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 3.67;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 3.67;
        value           uniform 3.67;
    }
    lowerWall
    {
        type            omegaWallFunction;
        value           uniform 3.67;
    }
    upperWall
    {
        type            slip;
    }
    T1rs
    {
        type            omegaWallFunction;
        value           uniform 3.67;
    }
}


