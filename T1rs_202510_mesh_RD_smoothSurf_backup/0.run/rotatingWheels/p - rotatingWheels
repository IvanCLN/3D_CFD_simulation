FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "include/initialConditions"

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $pressure;

boundaryField
{
    //- Set patchGroups for constraint patches
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            fixedValue;
        value           $internalField;
    }
	
    // Total moving ground
    lowerWall 
    {
        type            zeroGradient;
    }

    // wheels
    "(.*wheel)"  						//"(tire_front_wheel|tire_rear_wheel|rim_front_wheel|rim_rear_wheel)"    
    {
        type            zeroGradient;
    }

    // elements
    "(.*_wall)"  						//"(handlebar_wall|saddle_wall|frame_wall)"
    {
        type            zeroGradient;
    }

    #include "include/Domain"
}

