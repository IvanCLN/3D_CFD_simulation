FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    //- Set patchGroups for constraint patches
    #includeEtc "caseDicts/setConstraintTypes"



    inlet
    {
        type            calculated;
        value           $internalField;
    }

    outlet
    {
        type            calculated;
        value           $internalField;
    }

    // Total moving Ground
    "(Ground.*)"        
    {
        type            nutkWallFunction;
        value           $internalField;
    }

    // wheels
    "(.*wheel.*)"  						//"(tire_front_wheel|tire_rear_wheel|rim_front_wheel|rim_rear_wheel)"
    {
        type            nutkWallFunction;
        value           $internalField;
    }

    // elements
    "(.*wall)"  						//"(handlebar_wall|saddle_wall|frame_wall)"
    {
        type            nutkWallFunction;
        value           $internalField;
    }
	
	Domain
    {
        type            calculated;
        value           $internalField;
    }
}


